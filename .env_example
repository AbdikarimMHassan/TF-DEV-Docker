# Copy this file to .env (gitignored) before running the container locally.
# entry_point.sh sources this automatically, so any TF_VAR_* export here
# reaches Terraform without you having to pass -var on the command line —
# this is the same mechanic the real repo uses to hand engineers per-person
# values without putting them in tracked files.

export TF_VAR_engineer_name="Your Name"
